<header class="bg-gray-500/80 text-white p-4 sticky top-0 shadow-md">
  <nav class="container mx-auto flex justify-center items-center  ">
    <ul class="flex space-x-15 font-bold text-[20px]">
      <li>
        <a
          href="/"
          class="bg-red-400 py-2 px-4 rounded-md transition duration-300"
          >airbnb</a
        >
      </li>

      

      <% if(isLoggedIn){ %>
      <li>
        <a
          href="/homes"
          class="<%= currentPage === 'Home' ? 'bg-gray-400' : 'hover:bg-gray-300/65' %> py-2 px-4 rounded transition duration-300"
          >Homes-List</a
        >
      </li>

      <li>
        <a
          href="/favourites"
          class="<%= currentPage === 'favourites' ? 'bg-gray-400' : 'hover:bg-gray-300/65' %> py-2 px-4 rounded transition duration-300"
          >Favourites</a
        >
      </li>

      <li>
        <a
          href="/bookings"
          class="<%= currentPage === 'bookings' ? 'bg-gray-400' : 'hover:bg-gray-300/65' %> py-2 px-4 rounded transition duration-300"
          >Bookings</a
        >
      </li>

      <li>
        <a
          href="/host/host-home-list"
          class="<%= currentPage === 'host-homes' ? 'bg-gray-400' : 'hover:bg-gray-300/65' %> py-2 px-4 rounded transition duration-300"
          >Host Homes</a
        >
      </li>

      <li>
        <a
          href="/host/add-home"
          class="<%= currentPage === 'addHome' ? 'bg-gray-400' : 'hover:bg-gray-300/65' %> py-2 px-4 rounded transition duration-300"
          >Add Home</a
        >
      </li>
      <% } %>
      
      
      <% if(!isLoggedIn){ %>
        <li>
          <a 
            href="/login"
            class="bg-cyan-500 hover:bg-cyan-500/65 text-white font-semibold py-2 px-4 rounded-md shadow-md
            border-dashed"
            >Login
          </a>
        </li>

        <li>
          <a 
            href="/signup"
            class="bg-cyan-500 hover:bg-cyan-500/65 text-white font-semibold py-2 px-4 rounded-md shadow-md
            border-dashed"
            >SignUp
          </a>
        </li>

      <% } else { %>
        <li>
          <form action="/logout" method="POST">
            <button
            type="submit"
            class="bg-cyan-500 hover:bg-cyan-500/65 text-white font-semibold py-2 px-4 rounded-lg  shadow-md border-3 "
            >LogOut
           </button>
          </form> 
        </li>
          
      <% } %>

    </ul>
  </nav>
</header>