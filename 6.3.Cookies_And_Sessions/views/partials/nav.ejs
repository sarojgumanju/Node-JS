<header class="bg-gray-500/80 text-white p-4 shadow-md">
  <nav class="container mx-auto flex justify-center items-center">
    <ul class="flex space-x-15 font-bold">
      <li>
        <a
          href="/"
          class="<%= currentPage === 'index' ? 'bg-gray-400' : 'hover:bg-gray-300/65' %> py-2 px-4 rounded transition duration-300"
          >airbnb</a
        >
      </li>

      <% if(isLoggedIn){ %>
        <li>
        <a
          href="/homes"
          class="<%= currentPage === 'Home' ? 'bg-gray-400' : 'hover:bg-gray-300/65' %> py-2 px-4 rounded transition duration-300"
          >Homes-List</a
        >
      </li>
      <li>
        <a
          href="/favourites"
          class="<%= currentPage === 'favourites' ? 'bg-gray-400' : 'hover:bg-gray-300/65' %> py-2 px-4 rounded transition duration-300"
          >Favourites</a
        >
      </li>
      <li>
        <a
          href="/bookings"
          class="<%= currentPage === 'bookings' ? 'bg-gray-400' : 'hover:bg-gray-300/65' %> py-2 px-4 rounded transition duration-300"
          >Bookings</a
        >
      </li>
      <li>
        <a
          href="/host/host-home-list"
          class="<%= currentPage === 'host-homes' ? 'bg-gray-400' : 'hover:bg-gray-300/65' %> py-2 px-4 rounded transition duration-300"
          >Host Homes</a
        >
      </li>
      <li>
        <a
          href="/host/add-home"
          class="<%= currentPage === 'addHome' ? 'bg-gray-400' : 'hover:bg-gray-300/65' %> py-2 px-4 rounded transition duration-300"
          >Add Home</a
        >
      </li>
      <% } %>
      
      <li>
        <% if(!isLoggedIn){ %>
        <a 
          href="/login"
          class="bg-gray-400 hover:bg-gray/60 text-white font-semibold py-2 px-4 rounded-md shadow-md
          border-dashed"
          >Login</a>
        <% } else { %>
          <form action="/logout" method="POST">
            <button
            type="submit"
            class="bg-gray-400 hover:bg-gray-300/65 text-white font-semibold py-2 px-4 rounded-lg  shadow-md border-3 "
            >Logout
           </button>
          </form>
        <% } %>
      </li>
    </ul>
  </nav>
</header>